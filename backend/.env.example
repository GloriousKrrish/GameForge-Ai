# GameForge AI — Environment Configuration
# NEVER expose provider API keys to client-side code!

# Planner provider: "deterministic", "gemini", "openai", "anthropic"
GAMEFORGE_PLANNER_PROVIDER=deterministic

# Server-Side Provider Credentials
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database Configuration
DATABASE_URL=sqlite:///./gameforge.db

# Optional Custom LLM endpoint
LLM_API_URL=
LLM_MODEL_NAME=gemini-2.5-flash
